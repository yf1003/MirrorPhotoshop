{
  "manifestVersion": 5,
  "id": "local.yuanfan.psdmirror",
  "name": "PSD Mirror",
  "version": "0.3.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "25.0.0",
    "data": {
      "apiVersion": 2
    }
  },
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/icon48.png",
      "scale": [
        1
      ],
      "theme": [
        "darkest",
        "dark",
        "light",
        "lightest"
      ],
      "species": [
        "generic"
      ]
    },
    {
      "width": 48,
      "height": 48,
      "path": "icons/icon96.png",
      "scale": [
        2
      ],
      "theme": [
        "darkest",
        "dark",
        "light",
        "lightest"
      ],
      "species": [
        "generic"
      ]
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "mirrorPanel",
      "label": {
        "default": "PSD Mirror"
      },
      "minimumSize": {
        "width": 260,
        "height": 300
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 300,
        "height": 480
      },
      "preferredFloatingSize": {
        "width": 320,
        "height": 480
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/icon23.png",
          "scale": [
            1
          ],
          "theme": [
            "darkest",
            "dark",
            "light",
            "lightest"
          ]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/icon46.png",
          "scale": [
            2
          ],
          "theme": [
            "darkest",
            "dark",
            "light",
            "lightest"
          ]
        }
      ]
    },
    {
      "type": "command",
      "id": "startMirror",
      "label": {
        "default": "开始实时同步"
      }
    },
    {
      "type": "command",
      "id": "stopMirror",
      "label": {
        "default": "暂停同步"
      }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": [
        "http://localhost"
      ]
    }
  }
}
